---
import { Image } from 'astro:assets';
import type { Shot } from '../utils/screens';

interface Props {
  shots: Shot[];
}

const { shots } = Astro.props;
---
<div class="gallery">
  {
    shots.map((shot) => (
      <figure class="shot">
        <Image
          src={shot.image}
          alt={shot.alt}
          widths={[800, 1400, 2000]}
          sizes="(max-width: 1120px) 100vw, 1040px"
          loading="lazy"
          decoding="async"
        />
        <figcaption>{shot.caption}</figcaption>
      </figure>
    ))
  }
</div>

<dialog class="lightbox" id="lightbox" aria-label="Просмотр изображения">
  <img alt="" />
</dialog>

<script>
  const dialog = document.getElementById('lightbox');
  if (dialog instanceof HTMLDialogElement) {
    document.querySelectorAll<HTMLImageElement>('.shot img').forEach((img) => {
      img.addEventListener('click', () => {
        const target = dialog.querySelector('img');
        if (target) {
          target.src = img.currentSrc || img.src;
          target.alt = img.alt;
        }
        dialog.showModal();
      });
    });
    dialog.addEventListener('click', () => dialog.close());
    dialog.addEventListener('close', () => {
      dialog.querySelector('img')?.removeAttribute('src');
    });
  }
</script>
