---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  href: string;
  title: string;
  meta: string;
  image: ImageMetadata;
  alt: string;
}

const { href, title, meta, image, alt } = Astro.props;
---
<article class="card">
  <a href={href}>
    <div class="card-media">
      <Image
        src={image}
        alt={alt}
        widths={[400, 800]}
        sizes="(max-width: 700px) 100vw, 340px"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="card-body">
      <h3>{title}</h3>
      <p class="meta">{meta}</p>
    </div>
  </a>
</article>
