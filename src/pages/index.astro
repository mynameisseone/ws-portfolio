---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site } from '../data/site';
import { withBase } from '../utils/url';
import { coverFor } from '../utils/screens';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---
<BaseLayout>
  <section class="hero container">
    <p class="role">{site.role}</p>
    <h1>{site.name}</h1>
    <p class="intro">{site.intro}</p>
  </section>

  <section class="section" id="about">
    <div class="container prose">
      {site.about.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </section>

  <section class="section" id="projects">
    <div class="container">
      <h2 class="section-title">Проекты</h2>
      <div class="grid">
        {
          projects.map((project) => {
            const cover = coverFor(project.id, project.data.cover);
            if (!cover) return null;
            return (
              <ProjectCard
                href={withBase(`projects/${project.id}/`)}
                title={project.data.title}
                meta={`${project.data.customer.name} · ${project.data.years}`}
                image={cover.image}
                alt={`${project.data.title} — интерфейс`}
              />
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section" id="approach">
    <div class="container">
      <h2 class="section-title">Технический подход</h2>
      <div class="prose">
        <p>
          Отличительной особенностью первых трёх проектов является специально
          спроектированная архитектура взаимодействия клиентского (frontend) и
          серверного (backend) кода:
        </p>
        <ul>
          {site.approach.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
